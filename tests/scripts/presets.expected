id: com.charlieculbert.wclap-runtime-presets-example
name: WCLAP Runtime Presets Example
vendor: Charlie Culbert
version: 0.1.0
description: Complete CLAP preset example
features:
  audio-effect
  stereo
format: clap
presets:
  name  loadKey  location  soundpack  description  features
  Soft  soft  internal  com.charlieculbert.wclap-runtime-presets-example.pack  Quiet built-in preset  soft
  Loud  loud  internal  com.charlieculbert.wclap-runtime-presets-example.pack  Full-level built-in preset  loud
  Medium  @FIXTURES@/presets.clap/presets/medium.wclap-preset  com.charlieculbert.wclap-runtime-presets-example.pack  Host-provided preset file  medium
locations:
  name  kind  path
  Built-in presets  plugin
  Host preset files  file  @FIXTURES@/presets.clap/presets
filetypes:
  wclap-preset
providers:
  id  name
  com.charlieculbert.wclap-runtime-presets-example.factory  Runtime example presets
supported: true
params:
  id  name  module  value  text  min  max  default  flags
  0  Preset gain  0.25  25 %  0  1  0.25  readonly
