id: com.charlieculbert.wclap-runtime-log-example
name: WCLAP Runtime Log Example
vendor: Charlie Culbert
version: 0.1.0
description: All clap.log severities from three thread roles
features:
  utility
sampleRate: 48000
blockSize: 512
frames: 2400
channels: 2
sampleRate: 48000
peak: 0
rms: 0
silent: true
violations:
  severity  where     message                                 count
  WARN      clap.log  Playback is nearing the clip boundary   1
  ERROR     clap.log  Example recoverable error               1
  ERROR     clap.log  Example fatal diagnostic                1
  ERROR     clap.log  Example host-misbehaving diagnostic     1
  ERROR     clap.log  Example plug-in-misbehaving diagnostic  1
count: 5
violations:
count: 0
