# Writes OUTPUT, a source file holding every .js module under ROOT/src as a
# byte array, so the host's windows load Compost from the binary rather than
# from a checkout that a downloaded or installed build doesn't have.
function(nch_embed_compost ROOT OUTPUT)
    file(GLOB_RECURSE modules RELATIVE "${ROOT}/src" CONFIGURE_DEPENDS "${ROOT}/src/*.js")
    list(SORT modules)
    set(arrays "")
    set(table "")
    set(index 0)
    foreach(module IN LISTS modules)
        file(READ "${ROOT}/src/${module}" hex HEX)
        string(LENGTH "${hex}" digits)
        math(EXPR size "${digits} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # The trailing 0 keeps an empty file's array from having no elements.
        string(APPEND arrays "const unsigned char module${index}[] = {${bytes}0};\n")
        string(APPEND table "\t{\"${module}\", module${index}, ${size}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(CONCAT source "// Generated by cmake/embed-compost.cmake from ${ROOT}/src.\n"
        "#include \"compost-files.h\"\n\nnamespace nch {\nnamespace {\n\n${arrays}\n} // namespace\n\n"
        "const CompostFile kCompostFiles[] = {\n${table}};\n"
        "const size_t kCompostFileCount = ${index};\n\n} // namespace nch\n")
    # Rewriting an unchanged file would rebuild it on every configure.
    if(EXISTS "${OUTPUT}")
        file(READ "${OUTPUT}" previous)
        if(previous STREQUAL source)
            return()
        endif()
    endif()
    file(WRITE "${OUTPUT}" "${source}")
endfunction()
